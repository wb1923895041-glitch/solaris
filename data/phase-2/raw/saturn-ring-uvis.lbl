OBJECT                          = SERIES
  NAME                          = OCCULTATION_PROFILE
  INTERCHANGE_FORMAT            = ASCII
  ROWS                          = 12846
  COLUMNS                       = 6
  ROW_BYTES                     = 51
  SAMPLING_PARAMETER_NAME       = RING_INTERCEPT_RADIUS
  SAMPLING_PARAMETER_UNIT       = KILOMETER
  MINIMUM_SAMPLING_PARAMETER    = 73665.
  MAXIMUM_SAMPLING_PARAMETER    = 137890.
  SAMPLING_PARAMETER_INTERVAL   = 5.
  DESCRIPTION                   = "This is a radial profile of
Saturn's ring system from the Voyager 2 UVS delta Sco occultation
experiment. The data have been resampled to a uniform radial grid.
Estimates of the normal opacity (optical depth) and its uncertainty
are provided.


This particular file applies to the entire ring system, assuming
equatorial rings. It was generated by program
SOFTWARE/PROFILE/UVSRESAM.FOR with the following inputs:
    (1) Data file label: EDITDATA/US1D02P.LBL
    (2) Geometry file label: GEOMETRY/US1G02.LBL
    (3) Calibration file label: CALIB/US1C01.LBL
    (4) Radius min, max, interval = 73665., 137890., 5.
    (5) Filter type (boxcar,triangle,sinc): (B/T/S) = B
    (6) Output filename: EASYDATA/KM005/US1P01.TAB
"

  OBJECT                        = COLUMN
    NAME                        = RING_INTERCEPT_RADIUS
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 1
    BYTES                       = 9
    FORMAT                      = "F9.2"
    UNIT                        = KILOMETER
    DESCRIPTION                 = "Radial distance of the occultation
intercept point from the center of the planet, in kilometers.
Distances are measured along the ring plane."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MEAN_SIGNAL
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 11
    BYTES                       = 8
    FORMAT                      = "F8.3"
    MISSING_CONSTANT            = 0.
    UNIT                        = "N/A"
    DESCRIPTION                 = "Mean counts received by the UVS
instrument at this radial location. The background signal has not been
subtracted. For unconstrained segments of the data, this value is set
to 0."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MEAN_SIGNAL_UNCERTAINTY
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 20
    BYTES                       = 6
    FORMAT                      = "F6.3"
    MAXIMUM                     = 99.
    UNIT                        = "N/A"
    DESCRIPTION                 = "Estimate of the 1-sigma uncertainty
in the mean UVS counts. For unconstrained segments of the data, this
value is set to 99."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MEDIAN_NORMAL_OPACITY
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 27
    BYTES                       = 7
    FORMAT                      = "F7.4"
    MAXIMUM                     = 99.
    UNIT                        = "N/A"
    DESCRIPTION                 = "Estimate of the mean normal
opacity (optical depth) for a band of ring material centered at the
given radius. For opaque rings, this value is set to 99. For
unconstrained segments of the data, this value is set to 0."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = NORMAL_OPACITY_LOWER_LIMIT
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 35
    BYTES                       = 7
    FORMAT                      = "F7.4"
    MINIMUM                     = -9.
    MAXIMUM                     = 99.
    UNIT                        = "N/A"
    DESCRIPTION                 = "Estimate of the 1-sigma lower limit
on the ring opacity, corresponding to a 68% confidence interval. For
unconstrained segments of the data, this value is set to -9. For
opaque rings, this value is set to 99."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = NORMAL_OPACITY_UPPER_LIMIT
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 43
    BYTES                       = 7
    FORMAT                      = "F7.4"
    MAXIMUM                     = 99.
    UNIT                        = "N/A"
    DESCRIPTION                 = "Estimate of the 1-sigma upper limit
on the ring opacity, corresponding to a 68% confidence interval. For
opaque rings, this value is set to 99."
  END_OBJECT                    = COLUMN

END_OBJECT                      = SERIES
