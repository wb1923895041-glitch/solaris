{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "targetId",
    "centerId",
    "frame",
    "referencePlane",
    "correction",
    "epoch",
    "position",
    "velocity",
    "coverage",
    "source"
  ],
  "properties": {
    "kind": {
      "const": "ephemeris"
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "centerId": {
      "const": "0"
    },
    "frame": {
      "const": "ICRF"
    },
    "referencePlane": {
      "const": "FRAME"
    },
    "correction": {
      "const": "NONE"
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "scale",
        "origin"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "const": "s"
        },
        "scale": {
          "const": "TDB"
        },
        "origin": {
          "const": "J2000_TDB"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "unit": {
          "const": "km"
        }
      }
    },
    "velocity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "unit": {
          "const": "km/s"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startTdbSeconds",
        "endTdbSeconds",
        "unit"
      ],
      "properties": {
        "startTdbSeconds": {
          "type": "number"
        },
        "endTdbSeconds": {
          "type": "number"
        },
        "unit": {
          "const": "s"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "url",
        "retrievedAtUtc",
        "version",
        "sha256",
        "processing"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "retrievedAtUtc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "processing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOLARIS normalized ephemeris boundary v0.1"
}
